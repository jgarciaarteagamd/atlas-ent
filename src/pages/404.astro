---
import Base from '../layouts/Base.astro';
---
<Base lang="es" title="404 · Atlas ORL" description="Página no encontrada / Page not found" alt="/en/">
  <section class="wrap nf">
    <p class="label">404</p>
    <h1>Página no encontrada</h1>
    <p>La dirección no existe o ha cambiado. <a href="/es/">Ir al inicio</a></p>
    <p lang="en">Page not found. This address does not exist or has changed. <a href="/en/">Go to the home page</a></p>
  </section>
</Base>
<style>
  .nf { padding-block: 96px; display: grid; gap: 14px; }
  .nf p { margin: 0; }
</style>
