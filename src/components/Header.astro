---
import { ui, paths, bioUrl } from '../i18n/ui';
import type { Lang } from '../data/zones';

interface Props { lang: Lang; alt: string }
const { lang, alt } = Astro.props;
const t = ui[lang];
---

<header class="site">
  <div class="wrap bar">
    <a class="brand" href={paths.home(lang)} aria-label={`${t.brand} · ${t.forPatients}`}>
      <svg class="mark" viewBox="0 0 259.13 100" aria-hidden="true"><path d="M0 75.7V56.5H20.9V76.8Q20.9 81.2 25.2 81.2H44.9Q49.3 81.2 49.3 76.8V18.8H22V0H70.1V75.7Q70.1 100 45.8 100H24.3Q0 100 0 75.7ZM77.4 75.7V24.3Q77.4 0 101.7 0H143.6L153.3 7.5V18.8H102.6Q98.3 18.8 98.3 23.2V76.8Q98.3 81.2 102.6 81.2H135.4V58H116.2V39.1H156.2V100H101.7Q77.4 100 77.4 75.7ZM163.5 100L206.2 0L216.4 0L259.1 100L236.7 100L211.3 42.7L185.9 100Z" /></svg>
      <span class="name">{t.brand}</span>
      <span class="who">{t.forPatients}</span>
    </a>
    <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <a href={`${paths.home(lang)}#zonas`}>{t.navZones}</a>
      <a href={bioUrl(lang)} rel="author">{t.navAbout}</a>
      <a class="lang" href={alt} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'}>
        <span aria-hidden="true">{t.langShort}</span><span class="sr">{t.langName}</span>
      </a>
    </nav>
  </div>
</header>

<style>
  header.site {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: rgba(3, 7, 12, 0.78);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--holo-line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 12px;
  }
  .brand {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
    text-decoration: none;
    color: var(--ink);
    min-width: 0;
  }
  /* JGA monogram from the logo */
  .mark {
    align-self: center;
    height: 1.1rem;
    width: auto;
    fill: var(--holo);
  }
  .name {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.02em;
    color: var(--holo);
    text-shadow: 0 0 16px rgba(116, 241, 255, 0.4);
  }
  .who { color: var(--ink-soft); font-size: 0.9rem; }
  nav { display: flex; gap: 6px 20px; flex-wrap: wrap; align-items: center; }
  nav a {
    font-family: var(--label);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
  }
  nav a:hover { color: var(--flare); }
  .lang {
    border: 1px solid var(--holo-line);
    padding: 3px 8px;
    color: var(--holo) !important;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .who { display: none; }
  }
</style>
