---
import Base from '../layouts/Base.astro';
import HoloHead from './HoloHead.astro';
import { zones, type Lang } from '../data/zones';
import { ui, paths, otherLang, bioUrl } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} title={t.homeTitle} description={t.homeDescription} alt={paths.home(otherLang(lang))}>
  <h1 class="visually-hidden">{t.brand} · {t.tagline}</h1>
  <HoloHead lang={lang} />

  <section class="wrap intro">
    <div>
      <p class="label">{t.brand}</p>
      <h2>{t.introTitle}</h2>
    </div>
    <p>{t.introText}</p>
  </section>

  <section class="wrap" id="zonas" aria-labelledby="zonas-title">
    <h2 id="zonas-title" class="section-title">{t.allZones}</h2>
    <ul class="zones">
      {zones.map((z) => (
        <li>
          <a href={paths.zone(lang, z)} class="cut">
            <span class="label">{z.sub[lang]}</span>
            <span class="zname">{z.name[lang]}</span>
            <span class="zlede">{z.lede[lang]}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap about">
    <div class="card cut">
      <p class="label">{t.aboutTitle}</p>
      <h2>{t.doctor}</h2>
      <p>{t.aboutText}</p>
      <a class="button" href={bioUrl(lang)} rel="author">{t.aboutCta} <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 24px 64px;
    align-items: end;
    padding-block: 88px 56px;
  }
  .intro h2 { margin-top: 10px; }
  .intro > p { margin: 0; font-size: 1.1rem; line-height: 1.7; color: var(--ink); max-width: 62ch; }
  .section-title { margin-bottom: 24px; }
  .zones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }
  .zones a {
    display: grid;
    gap: 8px;
    height: 100%;
    padding: 20px 20px 22px;
    border: 1px solid var(--holo-line);
    background: rgba(7, 16, 25, 0.6);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 160ms, background 160ms;
  }
  .zones a:hover { border-color: rgba(255, 196, 107, 0.5); background: rgba(255, 196, 107, 0.05); }
  .zones a:hover .zname { color: var(--flare); }
  .zname { font-family: var(--display); font-size: 1.4rem; font-weight: 500; color: var(--holo); }
  .zlede { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.55; }
  .about { padding-top: 72px; }
  .card {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding: 28px;
    border: 1px solid var(--holo-line);
    background: linear-gradient(120deg, rgba(116, 241, 255, 0.06), rgba(7, 16, 25, 0.4));
  }
  .card p:not(.label) { margin: 0; max-width: 64ch; }
  @media (max-width: 760px) {
    .intro { grid-template-columns: 1fr; padding-block: 56px 40px; }
  }
</style>
