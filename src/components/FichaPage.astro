---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import { zoneById, type Lang } from '../data/zones';
import { markSvg, markWidth, markHeight, palettes } from '../data/mark.js';
import { ui, paths, otherLang, BIO_URL } from '../i18n/ui';

interface Props { entry: CollectionEntry<'fichas'> }
const { entry } = Astro.props;
const lang = entry.data.lang as Lang;
const t = ui[lang];
const zone = zoneById(entry.data.zone)!;
const kind = zone.topics.find((x) => x.key === entry.data.topic)?.kind;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);

// Same topic in the other language, if it has been published; otherwise the zone page.
const twin = (await getCollection('fichas')).find(
  (f) => f.data.lang === otherLang(lang) && f.data.zone === entry.data.zone && f.data.topic === entry.data.topic,
);
const alt = twin ? paths.ficha(otherLang(lang), zone, twin.data.slug) : paths.zone(otherLang(lang), zone);
const date = entry.data.updated.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const isoDate = entry.data.updated.toISOString().slice(0, 10);

const pageUrl = new URL(paths.ficha(lang, zone, entry.data.slug), Astro.site).href;
// Printed handouts carry a QR code back to the online page.
const qr = await QRCode.toString(pageUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M' });

const cover = entry.data.cover;
const ogImage = cover ? new URL((await getImage({ src: cover, width: 1200, format: 'jpg' })).src, Astro.site).href : undefined;

const doctor = {
  '@type': 'Physician',
  name: 'Juan García Arteaga',
  url: BIO_URL,
  medicalSpecialty: 'Otolaryngologic',
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `${pageUrl}#page`,
      url: pageUrl,
      name: entry.data.title,
      description: entry.data.summary,
      inLanguage: lang,
      lastReviewed: isoDate,
      dateModified: isoDate,
      author: doctor,
      reviewedBy: doctor,
      audience: { '@type': 'PeopleAudience', audienceType: 'Patient' },
      ...(ogImage && { image: ogImage }),
      about: { '@type': kind === 'patologia' ? 'MedicalCondition' : 'MedicalTherapy', name: entry.data.title },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.brand, item: new URL(paths.home(lang), Astro.site).href },
        { '@type': 'ListItem', position: 2, name: zone.name[lang], item: new URL(paths.zone(lang, zone), Astro.site).href },
        { '@type': 'ListItem', position: 3, name: entry.data.title, item: pageUrl },
      ],
    },
  ],
};
---

<Base lang={lang} title={`${entry.data.title} · ${t.brand}`} description={entry.data.summary} alt={alt} image={ogImage}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="wrap">
    <div class="print-only brandhead">
      <svg class="mark" viewBox={`0 0 ${markWidth} ${markHeight}`} aria-hidden="true" set:html={markSvg(palettes.light, 'jga-print')} />
      <span class="who"><strong>{t.doctor}</strong><br />{lang === 'es' ? 'Otorrinolaringólogo' : 'ENT specialist'}</span>
    </div>
    <nav class="crumbs label" aria-label={lang === 'es' ? 'Ruta' : 'Breadcrumb'}>
      <a href={paths.home(lang)}>{t.brand}</a> <span aria-hidden="true">/</span>
      <a href={paths.zone(lang, zone)}>{zone.name[lang]}</a>
      {kind && <><span aria-hidden="true">/</span> <span>{t.kinds[kind]}</span></>}
    </nav>
    <header class="head">
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
      <p class="meta label">
        {t.written} {t.doctor} · {t.lastReview}: <time datetime={isoDate}>{date}</time>
      </p>
      <button type="button" class="print-btn no-print" data-print>
        <span aria-hidden="true">⎙</span> {lang === 'es' ? 'Imprimir o guardar en PDF' : 'Print or save as PDF'}
      </button>
    </header>
    {cover && (
      <figure class="cover no-print">
        <Image src={cover} alt={entry.data.coverAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 1100px) 1100px, 100vw" loading="eager" />
      </figure>
    )}
    <div class="layout">
      <div class="prose">
        <Content />
        {entry.data.references.length > 0 && (
          <section class="refs">
            <h2 id="refs">{t.references}</h2>
            <ol>
              {entry.data.references.map((r) => (
                <li>{r.url ? <a href={r.url} rel="noopener">{r.label}</a> : r.label}</li>
              ))}
            </ol>
          </section>
        )}
        <blockquote>{t.disclaimerShort}</blockquote>
        <p class="no-print"><a href={paths.zone(lang, zone)}>← {t.backTo(zone.name[lang])}</a></p>
        <aside class="print-only handout">
          <div class="qr" set:html={qr} />
          <p>
            <strong>{t.doctor}</strong> · {t.specialty}<br />
            {lang === 'es' ? 'Escanea el código para ver esta ficha actualizada:' : 'Scan the code to see the latest version of this page:'}<br />
            {pageUrl}
          </p>
        </aside>
      </div>
      <nav class="toc no-print" aria-label={lang === 'es' ? 'En esta página' : 'On this page'}>
        <p class="label">{lang === 'es' ? 'En esta página' : 'On this page'}</p>
        <ol>
          {sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          {entry.data.references.length > 0 && <li><a href="#refs">{t.references}</a></li>}
        </ol>
      </nav>
    </div>
  </article>
</Base>

<script>
  for (const b of document.querySelectorAll('[data-print]')) b.addEventListener('click', () => window.print());
</script>

<style>
  .print-btn {
    justify-self: start;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    background: none;
    border: 1px solid var(--holo-line);
    color: var(--holo);
    font-family: var(--label);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 7px 12px;
    cursor: pointer;
  }
  .print-btn:hover { color: var(--flare); border-color: var(--flare); }
  .crumbs { padding-top: 28px; }
  .crumbs a { color: var(--holo-dim); text-decoration: none; }
  .head { padding-block: 32px 28px; display: grid; gap: 12px; max-width: var(--measure); }
  .lede { margin: 0; font-size: 1.1rem; line-height: 1.55; }
  .meta { color: var(--ink-soft); font-size: 0.62rem; font-weight: 500; letter-spacing: 0.06em; opacity: 0.75; }
  .cover { margin: 0 0 40px; border: 1px solid var(--holo-line); overflow: hidden; max-width: 1100px; }
  .cover :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 7; object-fit: cover; }
  .refs ol { font-size: 0.92rem; color: var(--ink-soft); }
  .layout { display: grid; gap: 64px; grid-template-columns: minmax(0, 1fr); }
  .toc { display: none; }
  .print-only { display: none; }
  @media (min-width: 1100px) {
    .layout { grid-template-columns: minmax(0, var(--measure)) 260px; }
    .toc { display: block; position: sticky; top: calc(env(safe-area-inset-top, 0px) + 90px); align-self: start; border-left: 1px solid var(--holo-line); padding-left: 18px; }
    .toc ol { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 8px; font-size: 0.9rem; }
    .toc a { color: var(--ink-soft); text-decoration: none; }
    .toc a:hover { color: var(--flare); }
  }
  :global(html) { scroll-padding-top: 90px; scroll-behavior: smooth; }
  @media print {
    .crumbs { display: none; }
    .head { padding: 0 0 6px; gap: 3px; max-width: none; }
    .lede { font-size: 1.05rem; line-height: 1.35; }
    .meta { font-size: 0.68rem; }
    .brandhead { align-items: center; gap: 10px; margin-bottom: 6px; padding-bottom: 5px; border-bottom: 1px solid #000; font-size: 0.85rem; }
    .brandhead .mark { height: 26px; width: auto; flex: none; }
    .brandhead .who { line-height: 1.25; }
    .refs ol { font-size: 0.85rem; }
    .print-only { display: flex; }
    .handout { gap: 12px; align-items: center; margin-top: 10px; padding-top: 8px; border-top: 1px solid #000; font-size: 0.85rem; break-inside: avoid; }
    .qr { width: 70px; flex: none; }
    .qr :global(svg) { width: 100%; height: auto; }
    .layout { display: block; }
  }
</style>
