---
// The five positions of the Brandt-Daroff exercises, illustrated with photos.
// Positions 2 and 4 show the head turn first and then lying down.
import { Image } from 'astro:assets';
import type { Lang } from '../data/zones';
import sentado from '../assets/brandt-daroff/sentado.jpg';
import cabezaIzquierda from '../assets/brandt-daroff/cabeza-izquierda.jpg';
import ladoDerecho from '../assets/brandt-daroff/lado-derecho.jpg';
import cabezaDerecha from '../assets/brandt-daroff/cabeza-derecha.jpg';
import ladoIzquierdo from '../assets/brandt-daroff/lado-izquierdo.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;

const es = lang === 'es';
const alt = {
  sit: es ? 'Hombre sentado en el borde de la cama, mirando al frente.' : 'Man sitting on the edge of the bed, looking straight ahead.',
  headLeft: es ? 'Sentado, con la cabeza girada hacia su hombro izquierdo.' : 'Sitting, with his head turned towards his left shoulder.',
  lyingRight: es ? 'Tumbado sobre el lado derecho, con la cara mirando en diagonal hacia el techo.' : 'Lying on his right side, face looking diagonally up at the ceiling.',
  headRight: es ? 'Sentado, con la cabeza girada hacia su hombro derecho.' : 'Sitting, with his head turned towards his right shoulder.',
  lyingLeft: es ? 'Tumbado sobre el lado izquierdo, con la cara mirando en diagonal hacia el techo.' : 'Lying on his left side, face looking diagonally up at the ceiling.',
};

const steps = [
  {
    title: es ? 'Posición 1' : 'Position 1',
    text: es ? 'Siéntate en el centro del borde de la cama, con los pies apoyados en el suelo y mirando al frente.' : 'Sit in the middle of the edge of the bed, feet on the floor, looking straight ahead.',
    images: [{ src: sentado, alt: alt.sit }],
  },
  {
    title: es ? 'Posición 2' : 'Position 2',
    text: es
      ? 'Gira la cabeza 45° hacia la izquierda y, sin enderezarla, túmbate rápido sobre tu lado derecho. Tu cara queda mirando en diagonal hacia el techo.'
      : 'Turn your head 45° to the left and, keeping it turned, quickly lie down on your right side. Your face ends up looking diagonally at the ceiling.',
    images: [{ src: cabezaIzquierda, alt: alt.headLeft }, { src: ladoDerecho, alt: alt.lyingRight }],
  },
  {
    title: es ? 'Posición 3' : 'Position 3',
    text: es ? 'Vuelve a sentarte y mira al frente.' : 'Sit back up and look straight ahead.',
    images: [{ src: sentado, alt: alt.sit }],
  },
  {
    title: es ? 'Posición 4' : 'Position 4',
    text: es
      ? 'Gira la cabeza 45° hacia la derecha y túmbate rápido sobre tu lado izquierdo, mirando en diagonal hacia el techo.'
      : 'Turn your head 45° to the right and quickly lie down on your left side, looking diagonally at the ceiling.',
    images: [{ src: cabezaDerecha, alt: alt.headRight }, { src: ladoIzquierdo, alt: alt.lyingLeft }],
  },
  {
    title: es ? 'Posición 5' : 'Position 5',
    text: es ? 'Vuelve a sentarte y mira al frente. Con esto completas un ciclo.' : 'Sit back up and look straight ahead. That completes one cycle.',
    images: [{ src: sentado, alt: alt.sit }],
  },
];
---

<ol class="bd-steps">
  {steps.map((s) => (
    <li>
      <div class:list={['pics', { pair: s.images.length > 1 }]}>
        {s.images.map((img, i) => (
          <>
            {i > 0 && <span class="then" aria-hidden="true">→</span>}
            <Image src={img.src} alt={img.alt} widths={[320, 520]} sizes="(min-width: 760px) 260px, 45vw" />
          </>
        ))}
      </div>
      <div class="text">
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .bd-steps {
    list-style: none;
    margin: 1.4em 0 1.8em;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .bd-steps li {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    padding: 12px;
    border: 1px solid var(--holo-line);
    background: color-mix(in srgb, var(--void-2) 55%, transparent);
    margin: 0;
  }
  /* every row uses the same two-picture grid so all photos share one size */
  .pics { display: grid; grid-template-columns: 1fr auto 1fr; gap: 6px; align-items: center; }
  .pics :global(img) { width: 100%; height: auto; display: block; border-radius: 2px; }
  .then { color: var(--flare); font-size: 1.2rem; }
  .bd-steps h3 { margin: 0 0 4px; font-size: 1.05rem; color: var(--holo); }
  .bd-steps p { margin: 0; }
  @media (max-width: 640px) {
    .bd-steps li { grid-template-columns: 1fr; }
  }
  @media print {
    .bd-steps { gap: 4px; }
    .bd-steps li { background: none; border-color: #999; break-inside: avoid; grid-template-columns: 0.9fr 1fr; gap: 10px; padding: 4px 6px; }
    .bd-steps h3 { color: #000; }
    .then { color: #000; }
  }
</style>
